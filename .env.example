# STATUSX 1.1 — TANPA LOGIN. File .env opsional.
# APP_USERNAME, APP_PASSWORD_HASH, dan SESSION_SECRET tidak diperlukan/diabaikan.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# Railway: NODE_ENV=production, TRUST_PROXY=1, DATA_DIR=/app/data
TRUST_PROXY=0
# Opsional. Jika kosong, otomatis memakai RAILWAY_PUBLIC_DOMAIN.
PUBLIC_ORIGIN=
BAILEYS_ENABLED=true
MAX_FILE_MB=40
MAX_STORAGE_MB=512
MAX_ZIP_MB=200
SESSION_HOURS=12
# Cookie anonim hanya untuk CSRF, bukan login. Kuncinya dibuat otomatis.
ALLOW_EMBED_PREVIEW=false
